{
  "info": {
    "_postman_id": "nuwefarma-api",
    "name": "NuweFarma API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jhonatanancasi@gmail.com\",\n  \"password\": \"10571705\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('authToken', jsonData.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["categorias"]
            }
          }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Antibióticos\",\n  \"descripcion\": \"Medicamentos antibióticos\",\n  \"estado\": \"activo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["categorias"]
            }
          }
        },
        {
          "name": "Ver",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categorias/{{categoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "{{categoriaId}}"]
            }
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Antibióticos Nuevos\",\n  \"estado\": \"inactivo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categorias/{{categoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "{{categoriaId}}"]
            }
          }
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/categorias/{{categoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "{{categoriaId}}"]
            }
          }
        },
        {
          "name": "Toggle Estado",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/categorias/{{categoriaId}}/toggle-estado",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "{{categoriaId}}", "toggle-estado"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?bajo_stock=true&proximo_vencer=true",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [
                {
                  "key": "bajo_stock",
                  "value": "true"
                },
                {
                  "key": "proximo_vencer",
                  "value": "true"
                },
                {
                  "key": "dias_alerta",
                  "value": "60"
                }
              ]
            }
          }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Amoxicilina 500mg\",\n  \"categoria_id\": \"{{categoriaId}}\",\n  \"precio_compra\": 50.00,\n  \"precio_venta\": 100.00,\n  \"stock_actual\": 10,\n  \"stock_minimo\": 5,\n  \"estado\": \"activo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        }
      ]
    },
    {
      "name": "Activity Logs",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activity-logs?per_page=15",
              "host": ["{{baseUrl}}"],
              "path": ["activity-logs"],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "Mis Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activity-logs/me",
              "host": ["{{baseUrl}}"],
              "path": ["activity-logs", "me"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    }
  ]
}
